modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["github:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 3002
externalPort = 3003

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 4200

[[ports]]
localPort = 22627
externalPort = 3000

[[ports]]
localPort = 22628
externalPort = 3001

[userenv]

[userenv.shared]
EXPO_PUBLIC_VAPI_ASSISTANT_ID = "1f6a73ec-abef-4181-ac53-31b6a037a613"
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY = "pk_test_ZGVzaXJlZC1haXJlZGFsZS0zNy5jbGVyay5hY2NvdW50cy5kZXYk"

[nix]
channel = "stable-25_05"
packages = ["eas-cli"]
